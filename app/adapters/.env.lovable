# ===================================================
# ZapNode - Configuração para Lovable CRM Integration
# ===================================================

# Configurações do ZapNode
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# ===================================================
# LOVABLE CRM API CONFIGURATION
# ===================================================

# URL base da API do seu Lovable CRM
# Exemplo: http://localhost:3000/api ou https://seu-crm.com/api
LOVABLE_API_URL=http://localhost:3000/api

# Chave de API para autenticação com Lovable CRM
# Esta chave deve ser configurada no seu CRM Lovable
# Você pode gerar uma chave de API nas configurações do seu CRM
LOVABLE_API_KEY=your_api_key_here

# Timeout para requisições à API do Lovable (em ms)
API_TIMEOUT=30000

# ===================================================
# WHATSAPP CONFIGURATION
# ===================================================

# Número de telefone do WhatsApp (com país e área)
# Exemplo: 5511999999999 (Brasil +55 11 99999-9999)
WHATSAPP_PHONE_NUMBER=5511999999999

# URL do webhook do ZapNode (para receber mensagens do WhatsApp)
# Exemplo: http://seu-dominio.com/webhook/whatsapp
WEBHOOK_URL=http://localhost:3001/webhook/whatsapp

# Port para o servidor de webhook
WEBHOOK_PORT=3001

# ===================================================
# DATABASE CONFIGURATION (SQLite local)
# ===================================================

# Caminho para o banco de dados SQLite
DB_PATH=./data/zapnode.db

# ===================================================
# LOGGING CONFIGURATION
# ===================================================

# Nível de log: error, warn, info, debug
LOG_LEVEL=info

# Diretório para arquivos de log
LOG_DIR=./logs

# ===================================================
# RETRY CONFIGURATION
# ===================================================

# Número de tentativas para requisições que falham
RETRY_ATTEMPTS=3

# Delay entre tentativas (em ms)
RETRY_DELAY=1000

# ===================================================
# FEATURE FLAGS
# ===================================================

# Habilitar sincronização de contatos
SYNC_CONTACTS=true

# Habilitar sincronização de mensagens
SYNC_MESSAGES=true

# Habilitar fechar conversa automaticamente
AUTO_CLOSE_CONVERSATION=false

# Tempo em minutos para fechar automaticamente a conversa (se AUTO_CLOSE_CONVERSATION=true)
AUTO_CLOSE_TIMEOUT=1440
